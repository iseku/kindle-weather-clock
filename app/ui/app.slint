export struct ForecastDay {
    week: string,
    icon: string,
    text: string,
    low: string,
    high: string,
}

export struct CalendarDay {
    day: string,
    label: string,
    is_today: bool,
}

export struct CalendarRow {
    cells: [CalendarDay],
}

export component AppWindow inherits Window {
    width: 1024px;
    height: 758px;
    title: "Kindle Weather Clock";
    background: #ffffff;

    // 退出中：盖一层全屏提示，免得 30 秒等待期间屏幕一片白像死机
    in property <bool> quitting: false;

    // Clock & calendar
    in property <string> time: "";
    in property <string> date: "";
    in property <string> lunar: "";
    in property <string> festival: "";
    in property <string> yi: "";
    in property <string> ji: "";
    // 日历农历小字用的字族：设备字体的粗体常常是独立字族名，由 Rust 侧按实际字体填
    in property <string> label-font: "";

    // Weather
    in property <string> weather-kind: "sun";
    in property <string> weather-text: "";
    in property <string> temp: "";
    in property <string> wind-dir: "";
    in property <string> wind-force: "";
    in property <string> humidity: "";

    // Location & battery
    in property <string> location: "";
    in property <string> battery: "";
    in property <string> wifi: "";

    // Models
    in property <[ForecastDay]> forecast: [];
    in property <[CalendarRow]> calendar: [];

    // 控制
    in property <int> brightness: 20;
    // 刷新进行中：按钮变灰、图标转起来、忽略再次点击
    // （WiFi 关着时一次刷新要等十几秒，没有反馈用户会以为没点上）
    in property <bool> refreshing: false;
    callback brightness-up();
    callback brightness-down();
    // 短按刷新图标：立刻重取天气并全屏重绘
    callback refresh-weather();
    // 长按刷新图标 5 秒：退出程序
    callback quit();
    callback toggle-wifi();

    HorizontalLayout {
        padding: 24px;
        // 底部多留 16px：触摸面板最下沿有死区，原先贴在 24px 处的 WiFi 按钮点不中
        padding-bottom: 40px;
        spacing: 24px;

        // ===== LEFT 60%: 日期 / 日历 / 黄历 =====
        VerticalLayout {
            spacing: 14px;
            horizontal-stretch: 6;
            vertical-stretch: 1;

            // 日期区
            VerticalLayout {
                spacing: 12px;
                Text { text: root.date; font-size: 42px; font-weight: 700; color: #cc0000; }
                Text { text: root.lunar; font-size: 30px; color: #000000; }
            }

            // 弹性空白：把日历块推到中间
            Rectangle { vertical-stretch: 1; }

            // 日历区
            VerticalLayout {
                spacing: 3px;

                HorizontalLayout {
                    spacing: 3px;
                    vertical-stretch: 0;
                    alignment: start;
                    Rectangle { width: 76px; height: 30px; background: #000000; Text { text: "日"; font-size: 27px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 76px; height: 30px; background: #000000; Text { text: "一"; font-size: 27px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 76px; height: 30px; background: #000000; Text { text: "二"; font-size: 27px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 76px; height: 30px; background: #000000; Text { text: "三"; font-size: 27px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 76px; height: 30px; background: #000000; Text { text: "四"; font-size: 27px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 76px; height: 30px; background: #000000; Text { text: "五"; font-size: 27px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 76px; height: 30px; background: #000000; Text { text: "六"; font-size: 27px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
                }

                for row in root.calendar : HorizontalLayout {
                    spacing: 2px;
                    vertical-stretch: 0;
                    alignment: start;
                    for cell in row.cells : Rectangle {
                        width: 76px;
                        height: 62px;
                        border-width: cell.is_today ? 2px : 0px;
                        border-color: #000000;
                        VerticalLayout {
                            alignment: center;   // 内容在 72px 格子里垂直居中，不贴框顶
                            padding: 2px;
                            spacing: 0px;
                            Text { text: cell.day; font-size: 27px; horizontal-alignment: center; vertical-stretch: 0; color: #000000; }
                            Text { text: cell.label; font-size: 17px; font-weight: 700; font-family: root.label-font; horizontal-alignment: center; vertical-stretch: 0; color: #000000; }
                        }
                    }
                }
            }

            // 弹性空白：黄历贴底
            Rectangle { vertical-stretch: 1; }

            // 黄历区：高度固定，底部状态栏（含 WiFi 按钮）就永远停在同一行。
            // 不固定的话，宜忌行数一变它就整体上下浮动——行数多的时候会沉到屏幕
            // 最下沿的触摸死区里，按钮就点不中了。
            Rectangle {
                height: 196px;
                background: transparent;
                // 极端长的宜忌宁可裁掉尾部，也不许把状态栏顶到屏幕外的触摸死区
                clip: true;
                VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "宜"; font-size: 32px; color: #000000; }
                    // 最多两行，超出用 … 省略（overflow: elide 会按可用高度自动算行数）
                    Text { text: root.yi; font-size: 26px; color: #000000; wrap: word-wrap; horizontal-stretch: 1; height: 64px; overflow: elide; vertical-alignment: top; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "忌"; font-size: 32px; color: #000000; }
                    Text { text: root.ji; font-size: 26px; color: #000000; wrap: word-wrap; horizontal-stretch: 1; height: 64px; overflow: elide; vertical-alignment: top; }
                }
                // 吃掉剩余高度，把状态栏顶到黄历区底部
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 16px;
                    // 城市贴左，电量与 WiFi 一起贴右——和手机状态栏的习惯一致
                    Text { text: root.location; font-size: 24px; color: #000000; height: 44px; vertical-alignment: center; }
                    // 弹性空白把右边两项推到屏幕右缘
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.battery; font-size: 24px; color: #000000; height: 44px; vertical-alignment: center; }
                    // 热区只包住文字本身；高度 44px 已经够手指点，左右留 12px 余量。
                    // padding 只有 layout 元素才生效，所以中间套一层 HorizontalLayout。
                    Rectangle {
                        background: transparent;
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: root.wifi;
                                font-size: 24px;
                                color: #000000;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.toggle-wifi(); }
                        }
                    }
                }
                }
            }
        }

        // ===== RIGHT 40%: 时钟 / 当前天气 / 3日天气 =====
        VerticalLayout {
            spacing: 18px;
            horizontal-stretch: 4;
            vertical-stretch: 1;

            // 时钟区
            Text {
                text: root.time;
                font-size: 145px;
                font-weight: 700;
                color: #000000;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // 当前天气区
            VerticalLayout {
                spacing: 10px;
                vertical-stretch: 1;

                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 106px;
                        height: 106px;
                        if root.weather-kind == "sun": Image { width: 106px; height: 106px; source: @image-url("icons/sun.svg"); image-fit: contain; }
                        if root.weather-kind == "cloud-sun": Image { width: 106px; height: 106px; source: @image-url("icons/cloud-sun.svg"); image-fit: contain; }
                        if root.weather-kind == "cloud": Image { width: 106px; height: 106px; source: @image-url("icons/cloud.svg"); image-fit: contain; }
                        if root.weather-kind == "cloud-rain": Image { width: 106px; height: 106px; source: @image-url("icons/cloud-rain.svg"); image-fit: contain; }
                        if root.weather-kind == "cloud-rain-wind": Image { width: 106px; height: 106px; source: @image-url("icons/cloud-rain-wind.svg"); image-fit: contain; }
                        if root.weather-kind == "cloud-lightning": Image { width: 106px; height: 106px; source: @image-url("icons/cloud-lightning.svg"); image-fit: contain; }
                        if root.weather-kind == "snowflake": Image { width: 106px; height: 106px; source: @image-url("icons/snowflake.svg"); image-fit: contain; }
                        if root.weather-kind == "cloud-fog": Image { width: 106px; height: 106px; source: @image-url("icons/cloud-fog.svg"); image-fit: contain; }
                        if root.weather-kind == "cloud-hail": Image { width: 106px; height: 106px; source: @image-url("icons/cloud-hail.svg"); image-fit: contain; }
                        if root.weather-kind == "haze": Image { width: 106px; height: 106px; source: @image-url("icons/haze.svg"); image-fit: contain; }
                        if root.weather-kind == "wind": Image { width: 106px; height: 106px; source: @image-url("icons/wind.svg"); image-fit: contain; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: root.weather-text; font-size: 48px; font-weight: 700; color: #000000; }
                        Text { text: root.temp; font-size: 68px; font-weight: 700; color: #000000; }
                    }
                }

                HorizontalLayout {
                    spacing: 44px;
                    VerticalLayout {
                        width: 165px;
                        spacing: 0px;
                        vertical-stretch: 0;
                        Text { text: "温度"; font-size: 35px; color: #555555; }
                        Text { text: root.temp; font-size: 30px; font-weight: 700; color: #000000; }
                    }
                    VerticalLayout {
                        width: 165px;
                        spacing: 0px;
                        vertical-stretch: 0;
                        Text { text: "湿度"; font-size: 35px; color: #555555; }
                        Text { text: root.humidity; font-size: 30px; font-weight: 700; color: #000000; }
                    }
                }
                HorizontalLayout {
                    spacing: 44px;
                    VerticalLayout {
                        width: 165px;
                        spacing: 0px;
                        vertical-stretch: 0;
                        Text { text: "风力"; font-size: 35px; color: #555555; }
                        Text { text: root.wind-force; font-size: 30px; font-weight: 700; color: #000000; }
                    }
                    VerticalLayout {
                        width: 165px;
                        spacing: 0px;
                        vertical-stretch: 0;
                        Text { text: "风向"; font-size: 35px; color: #555555; }
                        Text { text: root.wind-dir; font-size: 30px; font-weight: 700; color: #000000; }
                    }
                }
            }

            // 3日天气区
            VerticalLayout {
                spacing: 8px;
                Text { text: "三天预报"; font-size: 26px; font-weight: 700; color: #000000; }
                for day in root.forecast : HorizontalLayout {
                    spacing: 10px;
                    Text { text: day.week; font-size: 22px; width: 64px; color: #000000; }
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        if day.icon == "sun": Image { width: 32px; height: 32px; source: @image-url("icons/sun.svg"); image-fit: contain; }
                        if day.icon == "cloud-sun": Image { width: 32px; height: 32px; source: @image-url("icons/cloud-sun.svg"); image-fit: contain; }
                        if day.icon == "cloud": Image { width: 32px; height: 32px; source: @image-url("icons/cloud.svg"); image-fit: contain; }
                        if day.icon == "cloud-rain": Image { width: 32px; height: 32px; source: @image-url("icons/cloud-rain.svg"); image-fit: contain; }
                        if day.icon == "cloud-lightning": Image { width: 32px; height: 32px; source: @image-url("icons/cloud-lightning.svg"); image-fit: contain; }
                        if day.icon == "snowflake": Image { width: 32px; height: 32px; source: @image-url("icons/snowflake.svg"); image-fit: contain; }
                        if day.icon == "cloud-fog": Image { width: 32px; height: 32px; source: @image-url("icons/cloud-fog.svg"); image-fit: contain; }
                    }
                    Text { text: day.text; font-size: 22px; color: #000000; }
                    Text { text: day.low + "~" + day.high + "℃"; font-size: 22px; color: #000000; }
                }
            }
        }
    }

    // ===== 右侧控制条 =====
    VerticalLayout {
        x: root.width - 24px - 58px;
        y: 250px;
        width: 58px;
        spacing: 8px;

        Rectangle {
            width: 58px;
            height: 64px;
            background: #ffffff;
            border-width: 2px;
            border-color: #000000;
            Text { text: "+"; font-size: 40px; font-weight: 700; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.brightness-up(); } }
        }
        Rectangle {
            width: 58px;
            height: 44px;
            background: #ffffff;
            border-width: 2px;
            border-color: #000000;
            Text { text: root.brightness; font-size: 26px; font-weight: 700; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle {
            width: 58px;
            height: 64px;
            background: #ffffff;
            border-width: 2px;
            border-color: #000000;
            Text { text: "−"; font-size: 40px; font-weight: 700; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.brightness-down(); } }
        }
        Rectangle { width: 58px; height: 20px; background: transparent; }
        // 手动刷新：短按重取天气 + 全屏重绘，长按 5 秒退出
        // （直接放退出按钮太容易误触，改成需要刻意长按才生效）
        refresh-btn := Rectangle {
            width: 58px;
            height: 64px;
            // 刷新中把整块翻成黑底白图，是最省事也最显眼的「正在忙」信号。
            // 不画边框——这一列只有它是纯图标，上下两个亮度按钮带框，
            // 视觉上反而能区分「这个是另一种东西」。
            background: root.refreshing
                ? #000000
                : (refresh-ta.pressed ? #cccccc : #ffffff);

            property <int> hold-ticks: 0;
            property <bool> fired: false;
            // 当前显示第几帧（0..3，每帧 90°）
            property <int> frame: 0;

            // 静止：白底黑图标
            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 36px;
                height: 36px;
                source: @image-url("icons/refresh-ccw-dot.svg");
                image-fit: contain;
                visible: !root.refreshing;
            }

            // 刷新中：黑底白图标，轮流显示 4 个预旋转好的帧（0°/90°/180°/270°）。
            //
            // 不能用 transform-rotation 转同一张图——这块屏走的是 Slint 软件
            // 渲染器，而 i-slint-renderer-software-1.17.1/lib.rs:1270 的
            // supports_transformations() 直接返回 false，partial_renderer.rs:142
            // 检查后跳过变换，旋转完全无效（实测八帧方向一模一样）。
            // 也不能用 opacity 做「变灰」：二值渲染把灰度 <128 画黑、否则画白
            // （crates/slint-backend-kindle/src/platform.rs 的 rgb_to_gray），
            // 黑线乘 0.45 后灰度 140 会被抹成白色，图标整个消失。
            // 所以只能预生成旋转帧、逐帧换图。这些帧设计上不可见：翻白底黑图时
            // 它们不画，不进脏区。
            Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 36px; height: 36px; source: @image-url("icons/spin-0.svg"); image-fit: contain; visible: root.refreshing && refresh-btn.frame == 0; }
            Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 36px; height: 36px; source: @image-url("icons/spin-1.svg"); image-fit: contain; visible: root.refreshing && refresh-btn.frame == 1; }
            Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 36px; height: 36px; source: @image-url("icons/spin-2.svg"); image-fit: contain; visible: root.refreshing && refresh-btn.frame == 2; }
            Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 36px; height: 36px; source: @image-url("icons/spin-3.svg"); image-fit: contain; visible: root.refreshing && refresh-btn.frame == 3; }

            // 4 帧 × 1 秒 = 一格一秒慢慢转。墨水屏本身刷新就慢，转快了
            // 每帧都变成一次局部刷新的拖影，反而看不清；一秒一格既能表达
            // 「在忙」，也不至于让按钮区域抖成一片灰。
            Timer {
                interval: 1s;
                running: root.refreshing;
                triggered => {
                    refresh-btn.frame = Math.mod(refresh-btn.frame + 1, 4);
                }
            }

            refresh-ta := TouchArea {
                // 刷新中不接受任何点击（含长按退出）
                enabled: !root.refreshing;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        refresh-btn.hold-ticks = 0;
                        refresh-btn.fired = false;
                    } else if (event.kind == PointerEventKind.up) {
                        // 长按已触发退出就不再补一次刷新
                        if (!refresh-btn.fired) {
                            root.refresh-weather();
                        }
                    }
                }
            }

            // 按住期间每 100ms 记一拍，满 50 拍（5 秒）触发退出
            Timer {
                interval: 100ms;
                running: refresh-ta.pressed && !refresh-btn.fired;
                triggered => {
                    refresh-btn.hold-ticks += 1;
                    if (refresh-btn.hold-ticks >= 50) {
                        refresh-btn.fired = true;
                        root.quit();
                    }
                }
            }
        }
    }

    if root.quitting: Rectangle {
        background: #ffffff;
        VerticalLayout {
            alignment: center;
            Text {
                text: "正在退出…";
                font-size: 72px;
                font-weight: 700;
                color: #000000;
                horizontal-alignment: center;
            }
            Text {
                text: "正在恢复系统界面，请稍候";
                font-size: 28px;
                color: #666666;
                horizontal-alignment: center;
            }
        }
    }
}
